# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Build / temp
dist/
*.tmp
*.bak

# Test artifacts
tests/fixtures/_run/
tests/fixtures/_target/

# Local Claude state (when this kit is dogfooded onto itself)
.claude/state/

# Personal Claude Code overrides (should never be committed)
.claude/settings.local.json

# install.sh / uninstall.sh 가 만드는 백업 디렉토리
.harness-backup-*/
.harness-uninstall-backup-*/

# Hook 캐시 (kit 버전 알림) — 매 SessionStart 마다 자동 갱신, 추적 대상 아님
.harness-kit/cache.json
.env.telegram
.env.discord

# self-host 전용: install 이 생성하는 .env.*.example 템플릿. 매 install 마다
# 재생성되는 아티팩트라 추적 불필요. 또한 check-secrets.sh 의 .env file staged
# 패턴이 .env.*.example 까지 false positive 로 잡는 알려진 버그를 회피.
# (#queue.md Icebox: check-secrets.sh .env.*.example 패턴 제외 fix)
.env.telegram.example
.env.discord.example

# 리뷰 도구 출력물 (per-spec 로컬 아티팩트). /hk-code-review, /hk-gemini-review 가
# specs/<spec-dir>/ 에 저장. PR 에 포함시키지 않는 ephemeral 산출물.
# 패턴을 specs/ 하위로 한정해 .claude/commands/, sources/commands/ 의 슬래시 커맨드
# 정의 파일 (code-review.md / hk-code-review.md / hk-gemini-review.md) 에 영향 없음.
specs/**/code-review*.md

# (opt-in) 권한 우회 런처 — 커밋 차단 (install --with-skip-launcher 대칭)
/claude-dangerously-skip-permissions.sh

# codegraph 도구 로컬 DB
.codegraph/

# harness-kit
